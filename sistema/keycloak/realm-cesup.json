{
  "realm": "cesup",
  "enabled": true,
  "displayName": "CESUP / UFRGS",
  "displayNameHtml": "<b>CESUP</b> / UFRGS",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "rememberMe": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 36000,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "incidentes-pwa",
      "name": "PWA Incidentes",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost/*", "https://incidentes.cesup.ufrgs.br/*"],
      "webOrigins": ["http://localhost", "https://incidentes.cesup.ufrgs.br"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+" }
    },
    {
      "clientId": "incidentes-cli",
      "name": "Scripts e testes da API",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "incidentes-api",
      "name": "API Incidentes",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "secret": "secret123"
    },
    {
      "clientId": "grafana",
      "name": "Grafana",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "secret": "grafana_secret",
      "redirectUris": ["http://localhost/grafana/*"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "tecnico-interno",  "description": "Técnico do CESUP — registra, atende e cadastra ativos" },
      { "name": "terceirizado",     "description": "Prestador de serviço — registra e consulta" },
      { "name": "gestor",           "description": "Coordenação — consulta e métricas" },
      { "name": "plantonista",      "description": "Plantão — ACK e atendimento" },
      { "name": "somente-leitura",  "description": "Consulta incidentes e métricas, sem alterar" },
      { "name": "admin",            "description": "Administração do sistema — todas as ações" }
    ]
  },
  "users": [
    {
      "username": "tecnico", "enabled": true, "email": "tecnico@cesup.ufrgs.br",
      "firstName": "Técnico", "lastName": "Teste",
      "credentials": [{ "type": "password", "value": "tecnico123", "temporary": false }],
      "realmRoles": ["tecnico-interno"]
    },
    {
