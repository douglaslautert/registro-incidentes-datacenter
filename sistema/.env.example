# Endereço de acesso. Para usar na rede local, rode depois do make install:
#   make rede-local      (troca para https://<IP-do-servidor> e gera certificado)
PUBLIC_URL=http://localhost
PUBLIC_WS_URL=ws://localhost

# ── PostgreSQL (sistema de incidentes + Keycloak) ───────────────
POSTGRES_PASSWORD=cesup123

# ── MySQL (Zabbix + GLPI) ───────────────────────────────────────
MYSQL_ROOT_PASSWORD=root123
MYSQL_ZABBIX_PASSWORD=zabbix123
MYSQL_GLPI_PASSWORD=glpi123

# ── Valkey ──────────────────────────────────────────────────────
VALKEY_PASSWORD=valkey123

# ── Keycloak ────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin123
KC_HOSTNAME=localhost
KC_CLIENT_SECRET=secret123

# ── Garage S3 (preenchido automaticamente pelo install.sh) ──────
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# ── SMTP (opcional para testes) ─────────────────────────────────
SMTP_HOST=smtp.ufrgs.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── GSM ─────────────────────────────────────────────────────────
PLANTAO_PHONE=+555199999999

# ── Zabbix (preenchido automaticamente pelo install.sh) ─────────
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
# Senha do usuário 'incidentes_api' (mínimo 8 caracteres)
ZABBIX_API_PASSWORD=CesupApi-2026

# ── GLPI (preenchido automaticamente pelo install.sh) ───────────
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# ── API ─────────────────────────────────────────────────────────
SECRET_KEY=dev_secret_key_troque_em_producao

# ── Grafana ─────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# Token do vigia externo (copiar para o .env do vigia)
VIGIA_TOKEN=vigia-token-cesup-2026
