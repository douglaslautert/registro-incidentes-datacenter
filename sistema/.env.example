# ═══════════════════════════════════════════════════════════════
#  CESUP — localhost
# ═══════════════════════════════════════════════════════════════

# Endereço de acesso. Para usar na rede local, rode depois do make install:
#   make rede-local      (troca para https://<IP-do-servidor> e gera certificado)
PUBLIC_URL=http://localhost
PUBLIC_WS_URL=ws://localhost

# ── PostgreSQL (sistema de incidentes + Keycloak) ───────────────
POSTGRES_PASSWORD=cesup123

# ── MySQL (Zabbix + GLPI) ───────────────────────────────────────
MYSQL_ROOT_PASSWORD=root123
MYSQL_ZABBIX_PASSWORD=zabbix123
MYSQL_GLPI_PASSWORD=glpi123

# ── Valkey ──────────────────────────────────────────────────────
VALKEY_PASSWORD=valkey123

# ── Keycloak ────────────────────────────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin123
KC_HOSTNAME=localhost
KC_CLIENT_SECRET=secret123

# ── Garage S3 (preenchido automaticamente pelo install.sh) ──────
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=

# ── SMTP (opcional para testes) ─────────────────────────────────
SMTP_HOST=smtp.ufrgs.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Plantão (Sprint 4) — listas separadas por vírgula ───────────
# P1 e P2: SMS; P1: também ligação pelo modem GSM; todas: e-mail.
# Sem ACK no prazo (P1 10 min, P2 30, P3 120), entra o 2º nível.
PLANTAO_PHONE=+555199999999
PLANTAO_EMAIL=
PLANTAO_ESCALONAMENTO_PHONE=
PLANTAO_ESCALONAMENTO_EMAIL=

# ── Login (Sprint 2) ────────────────────────────────────────────
# true: a API só atende com login no Keycloak (use em produção).
# false: quem não se identifica age como anônimo (testes do artefato).
AUTH_OBRIGATORIA=false
# Token das integrações internas (webhook do Zabbix, e-mail, scripts) — gerado pelo install.sh
TOKEN_SERVICO=
# LDAP institucional (opcional): com LDAP_URL, `make keycloak-config` federa o LDAP
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_CREDENTIAL=
LDAP_USERS_DN=
LDAP_USERNAME_ATTR=uid
LDAP_PAPEL_PADRAO=tecnico-interno

# ── IA no cluster GPU (Sprints 5 e 6) — opcional ───────────────
# APIs compatíveis com a OpenAI (vLLM). Vazio: o sistema segue sem visão e com embeddings locais.
VISION_URL=
VISION_MODEL=Qwen2-VL-7B-Instruct
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=bge-m3
IA_API_KEY=
# Transcrição: base em CPU; com GPU, large-v3 (rebuild da API para baixar o modelo)
WHISPER_MODEL=base
WHISPER_DEVICE=auto

# ── Zabbix (preenchido automaticamente pelo install.sh) ─────────
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
# Senha do usuário 'incidentes_api' (mínimo 8 caracteres)
ZABBIX_API_PASSWORD=CesupApi-2026

# ── GLPI (preenchido automaticamente pelo install.sh) ───────────
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# ── API ─────────────────────────────────────────────────────────
SECRET_KEY=dev_secret_key_troque_em_producao

# ── Grafana ─────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# Token do vigia externo (copiar para o .env do vigia)
VIGIA_TOKEN=vigia-token-cesup-2026
